# /etc/eterm.env 样例（权限必须 0600，属主 eterm）
# 生成主密钥: openssl rand -base64 64
ETERM_MASTER_KEY=REPLACE_WITH_base64_64BYTES
# 生成 pepper: openssl rand -hex 32
ETERM_PEPPER=REPLACE_WITH_hex_32BYTES
ETERM_DB_DSN=eterm:CHANGE_ME@tcp(127.0.0.1:3306)/eterm?parseTime=true&multiStatements=true&loc=UTC
ETERM_LISTEN=127.0.0.1:8080
# 可选：仅允许指定网段访问（经 Caddy 转发后生效）
# ETERM_IP_WHITELIST=203.0.113.0/24,198.51.100.7/32
ETERM_TLS_TRUSTED_PROXY=127.0.0.1
